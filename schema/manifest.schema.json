{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest FM1-Drydock",
  "description": "Contrat partagé PC <-> ESP32 décrivant la racine du volume Drydock (/drydock sur l'ESP32, racine en PC Sync). Généré par drydock sync, parsé par drydock_storage. Toute modification est répercutée dans companion/src/drydock_sync/models.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "stock_v15",
    "rescue_helper",
    "vessels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stock_v15": {
      "$ref": "#/$defs/entry"
    },
    "rescue_helper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^rescue/[A-Za-z0-9._-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "vessels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "file",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "enum": [
            "firmware_hub",
            "github",
            "local"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^(stock|vessels)/[A-Za-z0-9._-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
