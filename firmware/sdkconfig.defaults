CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

# FAT interne (drydock_fs) : noms longs requis (manifest.json, *.fwsc) + label DRYDOCK
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_LABEL=y

# Console sur USB-SERIAL-JTAG (COM6) : REPL pour basculer de mode (pc_sync/host).
# Le secondaire est désactivé car il partage les broches USB avec TinyUSB.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# TinyUSB : classe MSC (PC Sync) activée.
# BUFSIZE >= CONFIG_WL_SECTOR_SIZE (4096) : le FIFO MSC doit pouvoir transporter un secteur WL complet.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
# USB Host : the FM-1 composite (audio+MIDI) config descriptor exceeds 256 bytes;
# raise the control-transfer buffer so enumeration can complete (fm1-flip fix).
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
